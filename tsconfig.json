{
  // "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "allowJs": true,
    "typeRoots": ["./@types", "./node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "*.js": ["*.ts"]
    },
    "moduleDetection": "force",
    "module": "Preserve",
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": ["**/*.ts"],
  "exclude": ["dist", "node_modules", "coverage", "docs"]
}
